# Passwords (required in production)
ADMIN_PASSWORD=change-me-admin
# Long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Storage: leave SUPABASE_* empty to store files on local disk (./data) - fine for your PC.
# For the free cloud host, fill these in (see README.md).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=music
